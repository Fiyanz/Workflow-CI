name: red-chili-pepper-pests

entry_points:
  main:
    parameters:
      dataset-dir: {type: str, default: "./RedChiliPepperPestsDataset"}
      epochs: {type: int, default: 1}
      batch_size: {type: int, default: 32}
    command: "python modelling.py --dataset-dir {dataset-dir} --epochs {epochs} --batch_size {batch_size}"
